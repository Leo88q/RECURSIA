# Copy to app/.env.local (never commit real values; .env* is git-ignored).
# Everything prefixed VITE_ is PUBLIC — it ends up in the JS bundle. Never put secrets here.

# devnet | testnet | mainnet-beta | localnet
VITE_CLUSTER=devnet
# empty = public endpoint of the cluster; use your own RPC for production
VITE_RPC_URL=
# optional websocket endpoint if different from RPC
VITE_WS_URL=
# empty = program id from the SDK (Anchor.toml)
VITE_PROGRAM_ID=
# hard cap for priority fees, micro-lamports per CU
VITE_MAX_PRIORITY_FEE=500000
